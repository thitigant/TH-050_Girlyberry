{
  "name": "unipulse",
  "version": "1.0.0",
  "private": true,
  "description": "UniPulse - Campus Feedback & Course Survey Platform (CPE 334)",
  "scripts": {
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm run build:server && npm run build:client",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "test": "npm run test:server && npm run test:client",
    "test:client": "npm --prefix client run test",
    "test:server": "npm --prefix server run test",
    "typecheck": "npm --prefix server run typecheck && npm --prefix client run test",
    "lint": "npm --prefix client run lint",
    "db:seed": "npm --prefix server run db:seed",
    "prisma:generate": "npm --prefix server run db:generate",
    "prisma:db:push": "npm --prefix server run db:push",
    "prisma:migrate": "npm --prefix server run db:migrate",
    "prisma:seed": "npm --prefix server run db:seed"
  }
}
